[
  {
    "id": "datetimeformat-node-v26-offset-timezone-kolkata",
    "source": "node:v26.0.0:datetimeformat:edge",
    "locale": "en-US",
    "feature": "offsetTimeZone",
    "options": {
      "hour": "2-digit",
      "hour12": false,
      "minute": "2-digit",
      "timeZone": "+05:30",
      "timeZoneName": "longOffset"
    },
    "input": "2021-01-10T12:00:00Z",
    "expected": "17:30 GMT+05:30",
    "expectedParts": [
      {
        "type": "hour",
        "value": "17"
      },
      {
        "type": "literal",
        "value": ":"
      },
      {
        "type": "minute",
        "value": "30"
      },
      {
        "type": "literal",
        "value": " "
      },
      {
        "type": "timeZoneName",
        "value": "GMT+05:30"
      }
    ],
    "expectedResolvedOptions": {
      "calendar": "gregory",
      "hour": "2-digit",
      "hour12": false,
      "hourCycle": "h23",
      "locale": "en-US",
      "minute": "2-digit",
      "numberingSystem": "latn",
      "timeZone": "+05:30",
      "timeZoneName": "longOffset"
    }
  },
